# ==============================================================================
# SISMOWATCH PDD - VARIABLES DE ENTORNO (PLANTILLA EJEMPLO)
# Copia este archivo a .env o ejecuta 'bash scripts/setup_env.sh' para autogenerarlo
# ==============================================================================

# --- PostgreSQL (Infraestructura Medallion) ---
POSTGRES_DB=sismowatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# --- Credenciales de Roles PostgreSQL (Mínimo Privilegio) ---
# Rol Ingesta: solo escribe/lee en schema 'raw'
INGEST_USER=sismo_ingest
INGEST_PASSWORD=replace_with_secure_ingest_password

# Rol Transformación: lee 'raw', escribe/lee 'staging', escribe/lee 'curated'
TRANSFORM_USER=sismo_transform
TRANSFORM_PASSWORD=replace_with_secure_transform_password

# Rol Lectura (API): solo lectura SELECT en schema 'curated'
READ_USER=sismo_reader
READ_PASSWORD=replace_with_secure_read_password

# --- Apache Airflow (Orquestación LocalExecutor) ---
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_UI_PORT=8080
AIRFLOW__CORE__FERNET_KEY=replace_with_base64_32bytes_fernet_key
AIRFLOW__CORE__SECRET_KEY=replace_with_secure_webserver_secret_key
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_secure_airflow_admin_password

# --- Backend API (FastAPI) ---
API_PORT=8000
JWT_SECRET_KEY=replace_with_random_64char_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Usuarios de la Plataforma (Sembrado inicial)
ADMIN_USER=admin
ADMIN_PASSWORD=replace_with_secure_platform_admin_password
VIEWER_USER=viewer
VIEWER_PASSWORD=replace_with_secure_platform_viewer_password

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Web (React + Vite) ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# --- Proveedores de Inteligencia Artificial (LLM) ---
# Proveedor primario: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Proveedor secundario (Fallback): Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Configuración de resiliencia IA
DEFAULT_AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=2
